 };
-// Note: E8M0 types are not supported in current HIP version
-// using fp8_e8_t = __hip_fp8_e8m0_fnuz;
-// using fp8_e8_2_t = __hip_fp8x2_e8m0_fnuz;
+// __hip_fp8_e8m0 is the ROCm E8M0 type. Codegen uses scalar fp8_e8_t and
+// .x/.y/.z/.w on the vector structs below.
+using fp8_e8_t = __hip_fp8_e8m0;
+
+struct __align__(2) fp8_e8_2_t {
+  fp8_e8_t x;
+  fp8_e8_t y;
+};
+
+struct __align__(4) fp8_e8_4_t {
+  fp8_e8_t x;
+  fp8_e8_t y;
+  fp8_e8_t z;
+  fp8_e8_t w;
+};
+
+__device__ fp8_e8_2_t make_fp8_e8_2_t(fp8_e8_t x, fp8_e8_t y) {
+  fp8_e8_2_t result;
+  result.x = x;
+  result.y = y;
+  return result;
+}
+
+__device__ fp8_e8_4_t make_fp8_e8_4_t(fp8_e8_t x, fp8_e8_t y, fp8_e8_t z,
+                                      fp8_e8_t w) {
+  fp8_e8_4_t result;
+  result.x = x;
+  result.y = y;
+  result.z = z;
+  result.w = w;
+  return result;
+}
 
