 // Store a single FP4 element into a packed fp4_e2_2_t array.
+// Adjacent elements share a byte. A plain read-modify-write races when those
+// elements are stored by different threads, so update one nibble with a
+// 32-bit compare-and-swap and leave the rest of the word unchanged.
 TL_DEVICE void tl_fp4_packed_store(fp4_e2_2_t *packed, int idx, fp4_e2_t val) {
-  if (idx & 1) {
-    packed[idx >> 1].set_y(val);
-  } else {
-    packed[idx >> 1].set_x(val);
+  uint8_t *byte = &packed[idx >> 1].__x;
+  uintptr_t addr = reinterpret_cast<uintptr_t>(byte);
+  unsigned int *word =
+      reinterpret_cast<unsigned int *>(addr & ~uintptr_t{3});
+  unsigned int shift =
+      static_cast<unsigned int>((addr & 3u) * 8u + ((idx & 1) ? 4u : 0u));
+  unsigned int mask = 0xFu << shift;
+  unsigned int bits = static_cast<unsigned int>(val.__x & 0x0Fu) << shift;
+  unsigned int old = *word;
+  while (true) {
+    unsigned int updated = (old & ~mask) | bits;
+    unsigned int seen = atomicCAS(word, old, updated);
+    if (seen == old)
+      return;
+    old = seen;
   }
 }
 
