--- a/tilelang/src/tl_templates/hip/hip_fp8.h	2026-11-13 16:22:47.493190749 +0000
+++ b/tilelang/src/tl_templates/hip/hip_fp8.h	2026-11-13 16:22:47.493190749 +0000
@@ -54,6 +54,13 @@
     data = *reinterpret_cast<unsigned char *>(&val);
   }
   __device__ fp8_e4_t(float val) {
+#if defined(__gfx940__) || defined(__gfx941__) || defined(__gfx942__)
+    // gfx94x device cvt is FNUZ (bias 8, max 240) and ignores the requested
+    // interpretation. torch.float8_e4m3fn is OCP E4M3 (bias 7, max 448).
+    // Encode with the software OCP recipe so the stored bits match that dtype.
+    data = internal::cast_to_f8<float, false>(val, /*wm=*/3, /*we=*/4,
+                                              /*clip=*/true);
+#else
     constexpr __hip_fp8_interpretation_t interp =
 #if (TILELANG_FP8_E4M3_VARIANT == TILELANG_FP8_E4M3_VARIANT_FNUZ)
         __HIP_E4M3_FNUZ;
@@ -61,12 +68,17 @@
         __HIP_E4M3;
 #endif
     data = __hip_cvt_float_to_fp8(val, __HIP_SATFINITE, interp);
+#endif
   }
   __device__ operator hip_fp8_e4_t() const {
     return *reinterpret_cast<const hip_fp8_e4_t *>(&data);
   }
   __device__ operator float() const {
+#if defined(__gfx940__) || defined(__gfx941__) || defined(__gfx942__)
+    return internal::cast_from_f8<float, false>(data, /*wm=*/3, /*we=*/4);
+#else
     return static_cast<float>(static_cast<hip_fp8_e4_t>(*this));
+#endif
   }
 };
 
