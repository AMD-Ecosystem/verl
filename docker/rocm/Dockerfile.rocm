ARG DEFAULT_BASE=rocm/primus:v26.9.1
ARG BASE_IMAGE=${DEFAULT_BASE}
FROM ${BASE_IMAGE:-$DEFAULT_BASE} AS pytorch_base

FROM pytorch_base AS install_vllm
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
# Set the working dir explicitly so later RUN steps don't rely on the base
# image's inherited WORKDIR being /workspace.
WORKDIR /workspace
ENV PYTORCH_ROCM_ARCH="gfx942;gfx950"

# Install Causal-Conv1d and its dependencies
ARG CAUSAL_CONV1D_REPO=https://github.com/Dao-AILab/causal-conv1d
ARG CAUSAL_CONV1D_BRANCH=e940ead2fd962c56854455017541384909ca669f

ENV CAUSAL_CONV1D_FORCE_BUILD=TRUE
ENV MAMBA_FORCE_BUILD=TRUE
ENV HIP_ARCHITECTURES=gfx942,gfx950

RUN cd /workspace \
    && git clone ${CAUSAL_CONV1D_REPO} causal-conv1d \
    && cd causal-conv1d \
    && git checkout ${CAUSAL_CONV1D_BRANCH} \
    && git show --oneline -s \
    # primus v26.9.1 torch headers require C++20 (ATen.h #error on -std=c++17).
    && sed -i 's/-std=c++17/-std=c++20/g' setup.py \
    && pip install --no-cache-dir --no-build-isolation . \
    && cd .. \
    && rm -fr causal-conv1d

# vLLM v0.32.0 — same version as verl's CUDA stack (pyproject.toml / uv.lock: vllm==0.32.0).
# PR #44972 (ROCm cuMem zeroing), #46009 (MoE weight storage) and #60367 (host
# access to sleep-mode cuMem; supersedes the unmerged #51369) are already in v0.32.0.
ARG VLLM_TAG="5df63a7203cdb9328d824a27b682e77c7b9928be"
# [Bugfix][ROCm] Restore MoE weight padding dropped by #46009 (merged after v0.32.0)
# Ref: https://github.com/vllm-project/vllm/pull/61872
ARG VLLM_PR_61872="3b43d2b01c2fb667101746e1acd33b6a3c9d0863"
RUN pip install --no-cache-dir setuptools_scm && \
    cd /workspace && git clone https://github.com/vllm-project/vllm && \
    cd vllm && git checkout ${VLLM_TAG} && \
    # Apply only the vllm/ source change; its test file conflicts on v0.32.0.
    git show ${VLLM_PR_61872} -- vllm/ | git apply && \
    # requirements/rocm.txt does not pin torch. Without this constraint a
    # dependency can replace the primus ROCm torch with a CUDA wheel.
    python3 -c 'import torch, pathlib; pathlib.Path("/tmp/rocm-constraints.txt").write_text(f"torch=={torch.__version__}\n")' && \
    pip install --no-cache-dir -c /tmp/rocm-constraints.txt -r requirements/rocm.txt && \
    MAX_JOBS=64 python3 setup.py develop --no-deps
# Put the runtime ROCm (_rocm_sdk_core) ahead of the base image's _rocm_sdk_devel
# entries. vLLM >= #56190 dlopens libtorch_cpu.so RTLD_GLOBAL before `import torch`;
# with _rocm_sdk_devel first on LD_LIBRARY_PATH that pulls in devel's comgr/libLLVM
# next to core's, and `import vllm` aborts with "Option 'spirv-expand-step'
# registered more than once". Upstream fix (not merged yet):
# https://github.com/vllm-project/vllm/pull/60911
# Set after the vLLM build so compilation keeps the base image's environment.
ENV ROCM_CORE=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core
ENV LD_LIBRARY_PATH="${ROCM_CORE}/lib:${ROCM_CORE}/lib/rocm_sysdeps/lib:${LD_LIBRARY_PATH}"
# Keep tilelang (0.1.10 from vLLM's requirements; apache-tvm-ffi==0.1.11 also
# satisfies xgrammar==0.2.8). The base image installs z3-solver as an .egg, so
# libz3.so.4.15 is not at site-packages/z3/lib where tilelang's RUNPATH looks;
# reinstall the same version from the wheel.
RUN pip install --no-cache-dir --force-reinstall --no-deps z3-solver==4.15.4.0
RUN python -c "import vllm, tilelang, xgrammar, tvm_ffi, transformers; \
from importlib.metadata import version as v; \
print(*[f'{p} {v(p)}' for p in ['vllm', 'tilelang', 'xgrammar', 'apache-tvm-ffi', 'transformers']], sep=' | ')"


FROM install_vllm AS install_verl
# verl main as of 2026-11-13: transformers<5.17, so it stays compatible with
# vLLM v0.32.0 (transformers>=5.16.1,<5.20).
ARG VERL_TAG="3503bec3420dbb8ee67f8c9da6c0721570ae75ac"
RUN cd /workspace && git clone https://github.com/verl-project/verl.git && \
    cd verl && git checkout ${VERL_TAG} && \
    git submodule update --init --recursive && \
    sed -i 's/^  vllm: {}/  vllm:\n    disable_custom_all_reduce: True/' /workspace/verl/verl/trainer/config/rollout/rollout.yaml && \
    sed -i 's/^  sglang: {}/  sglang:\n    disable_custom_all_reduce: True\n    attention_backend: triton/' /workspace/verl/verl/trainer/config/rollout/rollout.yaml && \
    pip install --no-cache-dir . 
    
# Qwen3.5 extras, matching pipelines/verl/Dockerfile (nightly path).
# This verl pin imports megatron.bridge, so it gets megatron-bridge 0.6.2
# (already registers qwen3_asr with exist_ok), megatron-energon 7.4.1, and
# megatron-core 0.19.2. Bridge is --no-deps and requires wandb==0.29.0.
# Energon is --no-deps, so its runtime deps are installed explicitly.
# s3fs is --no-deps: a normal install pulls aiobotocore, which downgrades
# botocore, wrapt, and multidict. The PyPI flash-linear-attention wheel
# omits the ops package, so install it from GitHub and drop the autotune
# key Triton 3.9 rejects.
RUN pip install --no-cache-dir 'wandb==0.29.0' \
    && python3 -c "import wandb; print('wandb', wandb.__version__)"
RUN pip install --no-cache-dir 'torchao>=0.16.0' \
    && python3 -c "import torchao; print('torchao', torchao.__version__)"
RUN pip install --no-cache-dir torchdata \
    && python3 -c "from torchdata.stateful_dataloader import StatefulDataLoader; import torchdata; print('torchdata', torchdata.__version__)"
RUN pip install --no-cache-dir cupy-rocm-7-0 \
    && python3 -c "import cupy; print('cupy', cupy.__version__)"
RUN pip install --no-cache-dir \
        codetiming \
        pylatexenc \
        qwen-vl-utils \
    && pip install --no-cache-dir --no-deps \
        "git+https://github.com/fla-org/flash-linear-attention.git" \
    && f=/opt/venv/lib/python3.12/site-packages/fla/ops/cp/chunk_delta_h.py \
    && { [ ! -f "$f" ] || sed -i "s/key=\\['HV', 'K', 'V', 'BT'\\]/key=['HV', 'K', 'V']/" "$f"; } \
    && pip install --no-cache-dir --no-deps \
        "megatron-bridge==0.6.2" \
        "megatron-energon==7.4.1" \
    && pip install --no-cache-dir \
        "multi-storage-client>=0.40.0" \
        braceexpand \
        "filetype>=1.0.0" \
        mfusepy \
        "rapidyaml>=0.10.0" \
        webdataset \
    && pip install --no-cache-dir --no-deps "s3fs==2025.3.0" \
    && python3 -c "import braceexpand, filetype, ryml, webdataset, multistorageclient; from megatron.energon import WorkerConfig; print('energon deps ok')" \
    && pip install --no-cache-dir "megatron-core==0.19.2" \
    && pip install --no-cache-dir \
        mistral-common \
        mathruler \
        model-hosting-container-standards \
        transferqueue \
    && pip install --no-cache-dir --upgrade "transformers>=5.16.1,<5.20" \
        "accelerate>=1.14.0"

FROM install_verl AS install_sglang

ENV SGLANG_USE_AITER=0
ENV SGLANG_ATTENTION_BACKEND=triton
# /opt/venv/bin/hipcc is a pip wrapper that imports rocm_sdk_core; pip's isolated
# build envs cannot import it (torch_memory_saver fails). Put the SDK's own hipcc
# first on PATH for this stage, as causal-conv1d already does by absolute path.
ENV PATH="${ROCM_PATH}/bin:${PATH}"
ARG SGLANG_TAG="0801cc05ed202544e2e5c67d6b0a1d454de54fca"

RUN cd /workspace && git clone https://github.com/sgl-project/sglang.git && \
    cd sglang && git checkout ${SGLANG_TAG} && \
    # [Bugfix][ROCm] Fix vllm fused_add_rms_norm 6-arg crash on non-AITER path
    # Ref: https://github.com/sgl-project/sglang/pull/32034
    sed -zi 's/            out = torch.empty_like(x)\n            residual_out = torch.empty_like(x)\n            if post_residual_addition is not None:\n                residual = residual + post_residual_addition\n            fused_add_rms_norm(\n                out, x, residual_out, residual, self.weight.data, self.variance_epsilon\n            )\n            return out, residual_out/            if post_residual_addition is not None:\n                residual = residual + post_residual_addition\n            residual = residual.contiguous()\n            fused_add_rms_norm(x, residual, self.weight.data, self.variance_epsilon)\n            return x, residual/' \
      python/sglang/srt/layers/layernorm.py && \
    sed -zi 's/                out = torch.empty_like(x)\n                residual_out = torch.empty_like(x)\n                if post_residual_addition is not None:\n                    residual = residual + post_residual_addition\n                fused_add_rms_norm(\n                    out, x, residual_out, residual, w, self.variance_epsilon\n                )\n                return out, residual_out/                if post_residual_addition is not None:\n                    residual = residual + post_residual_addition\n                residual = residual.contiguous()\n                fused_add_rms_norm(x, residual, w, self.variance_epsilon)\n                return x, residual/' \
      python/sglang/srt/layers/layernorm.py && \
    # [Bugfix][VLM] Qwen2.5-VL vision rotary embedding vs transformers >5.8:
    # forward(seqlen) became forward(position_ids), so the GPU scalar sglang passes
    # in hit "cuda:0 and cpu" against the CPU inv_freq buffer and killed the
    # scheduler. Build the sequence locally so both transformers APIs work.
    sed -zi 's|        max_grid_size = grid_thw\[:, 1:\]\.max()\n        rotary_pos_emb_full = self\.rotary_pos_emb(max_grid_size)|        max_grid_size = int(grid_thw[:, 1:].max())\n        # transformers >5.8 changed forward(seqlen) to forward(position_ids); build\n        # the sequence here so both APIs work. inv_freq stays on CPU like pos_ids.\n        inv_freq = self.rotary_pos_emb.inv_freq\n        seq = torch.arange(max_grid_size, device=inv_freq.device, dtype=inv_freq.dtype)\n        rotary_pos_emb_full = torch.outer(seq, inv_freq)|' \
      python/sglang/srt/models/qwen2_5_vl.py && \
    # transformers>=5.12 already registers qwen3_asr; this SGLang commit must not fail on re-register.
    sed -i 's/AutoConfig.register("qwen3_asr", Qwen3ASRConfig)/AutoConfig.register("qwen3_asr", Qwen3ASRConfig, exist_ok=True)/' \
      python/sglang/srt/configs/qwen3_asr.py && \
    sed -i 's/AutoConfig.register("qwen3_asr_thinker", Qwen3ASRThinkerConfig)/AutoConfig.register("qwen3_asr_thinker", Qwen3ASRThinkerConfig, exist_ok=True)/' \
      python/sglang/srt/configs/qwen3_asr.py && \
    sed -i 's|^\[\[tool.setuptools-rust.ext-modules\]\]|# [[tool.setuptools-rust.ext-modules]]|; s|^target = "sglang.srt.grpc._core"|# target = "sglang.srt.grpc._core"|; s|^path = "../rust/sglang-grpc/Cargo.toml"|# path = "../rust/sglang-grpc/Cargo.toml"|; s|^binding = "PyO3"|# binding = "PyO3"|' python/pyproject.toml && \
    python3 -c 'import torch, pathlib; pathlib.Path("/tmp/rocm-constraints.txt").write_text(f"torch=={torch.__version__}\n")' && \
    # Versions vLLM v0.32.0 requires. SGLang's own pins for these (xgrammar 0.2.7,
    # outlines 0.1.11, llguidance <0.8, timm 1.0.16) would downgrade vLLM's deps,
    # so they are not installed here and vLLM's versions are enforced instead.
    printf '%s\n' 'xgrammar==0.2.8' 'outlines_core==0.2.14' 'llguidance>=1.7.0,<1.8.0' 'timm>=1.0.17' > /tmp/vllm-constraints.txt && \
    pip install --no-cache-dir -c /tmp/rocm-constraints.txt -c /tmp/vllm-constraints.txt \
      IPython \
      soundfile==0.13.1 \
      "git+https://github.com/fzyzcjy/torch_memory_saver.git" \
      aiohttp \
      "anthropic>=0.20.0" \
      blobfile==3.0.0 \
      compressed-tensors \
      datasets \
      distro \
      easydict \
      einops \
      fastapi \
      interegular \
      modelscope \
      msgspec \
      nvidia-ml-py \
      openai-harmony==0.0.4 \
      "openai>=2.25.0,<3" \
      orjson \
      partial_json_parser \
      pillow \
      "prometheus-client>=0.20.0" \
      py-spy \
      pybase64 \
      "pyzmq>=25.1.2" \
      python-multipart \
      scipy \
      sentencepiece \
      setproctitle \
      tiktoken \
      uvicorn \
      uvloop \
      watchfiles && \
    pip install --no-cache-dir --no-build-isolation --no-deps ./python && \
    cd sgl-kernel && cp pyproject_rocm.toml pyproject.toml && rm -rf build && \
    sed -i 's|f"--amdgpu-target={amdgpu_target}"|"--offload-arch=gfx942", "--offload-arch=gfx950"|' setup_rocm.py && \
    sed -i '/amdgpu_target not in \["gfx942", "gfx950"\]/,/sys.exit(1)/d' setup_rocm.py && \
    # primus v26.8+ torch headers need C++20; this SGLang commit still passes -std=c++17.
    sed -i 's/-std=c++17/-std=c++20/' setup_rocm.py && \
    sed -zi 's/#if HIP_FP8_TYPE_FNUZ\n#include <c10\/util\/Float8_e4m3fnuz.h>\nusing FP8_TYPE = c10::Float8_e4m3fnuz;\nconstexpr auto FP8_E4M3_MAX = 224.0f;\n#else\n#if HIP_FP8_TYPE_E4M3\n#include <c10\/util\/Float8_e4m3fn.h>\nusing FP8_TYPE = c10::Float8_e4m3fn;\nC10_HOST_DEVICE constexpr auto FP8_E4M3_MAX = std::numeric_limits<FP8_TYPE>::max();\n#else\n#error "fp8 is not supported in this processor (arch < gfx942)."\n#endif  \/\/ HIP_FP8_TYPE_E4M3\n#endif  \/\/ HIP_FP8_TYPE_FNUZ/#if defined(__gfx942__)\n#include <c10\/util\/Float8_e4m3fnuz.h>\nusing FP8_TYPE = c10::Float8_e4m3fnuz;\nconstexpr auto FP8_E4M3_MAX = 224.0f;\n#else\n#include <c10\/util\/Float8_e4m3fn.h>\nusing FP8_TYPE = c10::Float8_e4m3fn;\nC10_HOST_DEVICE constexpr auto FP8_E4M3_MAX = std::numeric_limits<FP8_TYPE>::max();\n#endif  \/\/ __gfx942__/' include/utils.h && \
    python setup_rocm.py install

# [Patch] megatron-core attention backend: assert → warn + override
# Base image sets NVTE_FLASH_ATTN=0/NVTE_FUSED_ATTN=1 which conflicts with
# megatron-core's attention_backend config (flash or auto).
RUN sed -i \
    's/            assert current_value is None or current_value == str(/            if current_value is not None and current_value != str(expected_value):/' \
    /opt/venv/lib/python3.12/site-packages/megatron/core/models/common/language_module/language_module.py && \
    sed -i \
    's/                expected_value/                import warnings/' \
    /opt/venv/lib/python3.12/site-packages/megatron/core/models/common/language_module/language_module.py && \
    sed -i \
    "s/            ), f'{env_variable_name} set to {current_value}, but expected {expected_value} for attention backend type {attn_type.name}. unset NVTE_FLASH_ATTN, NVTE_FUSED_ATTN and NVTE_UNFUSED_ATTN. Use the --attention-backend argument if you want to choose between (flash\/fused\/unfused\/auto\/local). Default is auto.'/                warnings.warn(f'{env_variable_name} was {current_value}, overriding to {expected_value} for attention backend {attn_type.name}')/" \
    /opt/venv/lib/python3.12/site-packages/megatron/core/models/common/language_module/language_module.py

ENV NVTE_USE_GROUPED_GEMM_TRITON=1
ENV NCCL_DEBUG=ERROR
ENV ROCPROFILER_LOG_LEVEL=fatal
ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV PYTORCH_ALLOC_CONF=expandable_segments:True
ENV MIOPEN_DEBUG_FORCE_IMMED_MODE_FALLBACK=1
# scikit-learn and joblib (imported via transformers) default KMP_INIT_AT_FORK to
# FALSE. torch here uses the ROCm SDK's LLVM OpenMP, which then skips its at-fork
# reset, and a fork-started dataloader worker can deadlock in torch.set_num_threads(1).
# Set it explicitly so that default is not applied.
ENV KMP_INIT_AT_FORK=TRUE
# v26.9.1 ships amdsmi already installed under share/amd_smi and loads
# libamd_smi by a path relative to that file, so the package has to stay
# put. A site-packages .pth adds it to sys.path. Loading it clashes with
# rocm_sdk's RTLD_GLOBAL preload and torch.cuda.device_count() returns 0,
# so the preload is switched to RTLD_LOCAL.
RUN SP="$(python -c 'import site; print(site.getsitepackages()[0])')" \
    && printf '%s\n' "$SP/_rocm_sdk_core/share/amd_smi" > "$SP/amdsmi.pth" \
    && sed -i 's/rtld_global: bool = True/rtld_global: bool = False/g' \
        "$(python -c 'import rocm_sdk, os; print(os.path.dirname(rocm_sdk.__file__))')/__init__.py"
RUN apt-get update && apt-get install -y --no-install-recommends vim \
    && rm -rf /var/lib/apt/lists/*

# Fail if any later pip step left vLLM with unmet requirements (e.g. a transformers downgrade).
RUN ! pip check 2>/dev/null | grep -E '^vllm '
RUN python -c "import vllm, tilelang, xgrammar, transformers, verl; \
from importlib.metadata import version as v; \
print('final:', *[f'{p} {v(p)}' for p in ['vllm', 'tilelang', 'xgrammar', 'transformers', 'verl']], sep=' | ')"

# Tilelang HIP headers and verl QAT / Qwen image-pad decode. Same patch set
# as the verl pipeline image. Kept after the last pip install so a reinstall
# cannot restore the upstream sources. Tests import /workspace/verl, so the
# verl patches are applied there as well as to the site-packages copy.
COPY docker/rocm/patches/hip-fp8-e8m0.patch \
     docker/rocm/patches/hip-fp8-e4m3-ocp.patch \
     docker/rocm/patches/hip-fp4-gfx942.patch \
     docker/rocm/patches/hip-fp4-atomic-store.patch \
     docker/rocm/patches/fp4-disable-vectorize.patch \
     docker/rocm/patches/fp4-scale-div.patch \
     docker/rocm/patches/fp8-disable-vectorize.patch \
     docker/rocm/patches/qwen-image-pad-decode.patch \
     /tmp/verl-patches/
RUN set -eu \
    && for site in /opt/venv/lib/python*/site-packages; do \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/hip-fp8-e8m0.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/hip-fp8-e4m3-ocp.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/hip-fp4-gfx942.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/hip-fp4-atomic-store.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/fp4-disable-vectorize.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/fp4-scale-div.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/fp8-disable-vectorize.patch && \
         patch -d "${site}" -p1 --forward --batch < /tmp/verl-patches/qwen-image-pad-decode.patch; \
       done \
    && patch -d /workspace/verl -p1 --forward --batch < /tmp/verl-patches/fp4-disable-vectorize.patch \
    && patch -d /workspace/verl -p1 --forward --batch < /tmp/verl-patches/fp4-scale-div.patch \
    && patch -d /workspace/verl -p1 --forward --batch < /tmp/verl-patches/fp8-disable-vectorize.patch \
    && patch -d /workspace/verl -p1 --forward --batch < /tmp/verl-patches/qwen-image-pad-decode.patch \
    && rm -rf /tmp/verl-patches

# Clean build artifacts and caches
RUN rm -rf /*.whl \
    && rm -rf /root/.cache \
    && rm -rf /root/.triton \
    && rm -rf /workspace/aiter/aiter/jit/build \
    && rm -rf /workspace/TransformerEngine

# Training docker manifest
ARG GIT_COMMIT_TAG=DEV
ARG DOCKERFILE_PATH=Dockerfile

# Copy patch files for training docker versioning
RUN mkdir -p /workspace/.manifest \
    && env > /workspace/.manifest/env.txt \
    && pip list > /workspace/.manifest/requirements.txt \
    && dpkg -l > /workspace/.manifest/dpkg-list.txt \
    && echo "${GIT_COMMIT_TAG}" > /workspace/.manifest/training_docker_version

CMD ["/usr/bin/bash"]